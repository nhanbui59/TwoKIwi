#@TYPE: Machine
#@NAME: onekiwi-rzv2l
#@DESCRIPTION: OneKiWi SOM V2L (R9A07G054L23GBG, DDR4 2GB, PMIC)

SOC_FAMILY = "r9a07g054l"
require conf/machine/include/rzv2l-common.inc
require conf/machine/include/cip-core.inc

DEFAULTTUNE ?= "cortexa55"
require conf/machine/include/tune-cortexa55.inc

PREFERRED_PROVIDER_virtual/kernel = "linux-renesas"

UBOOT_CONFIG ??= "onekiwi-rzv2l"
UBOOT_CONFIG[onekiwi-rzv2l] = "smarc-rzv2l_defconfig"

# PMIC support — always enabled for OneKiWi board
PMIC_SUPPORT ?= "1"

EXTRA_IMAGEDEPENDS += " flash-writer"

KERNEL_DEVICETREE = " \
    renesas/r9a07g054l2-smarc.dtb \
"
# OneKiWi custom DTB — will be added once available
# KERNEL_DEVICETREE += " renesas/onekiwi-rzv2l.dtb"

IMAGE_BOOT_FILES = " \
    bl2_bp-${MACHINE}_pmic.bin \
    bl2_bp-${MACHINE}.bin \
    fip-${MACHINE}_pmic.bin \
    fip-${MACHINE}.bin \
    bl2_bp-${MACHINE}_pmic.srec \
    bl2_bp-${MACHINE}.srec \
    fip-${MACHINE}_pmic.srec \
    fip-${MACHINE}.srec \
    Flash_Writer_SCIF_RZV2L_SMARC_PMIC_DDR4_2GB_1PCS.mot \
"

WIC_INPUT_DEPENDS = "firmware-pack:do_deploy flash-writer:do_deploy"
