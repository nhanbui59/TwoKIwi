# /etc/default/hud — cau hinh HUD. Sua tep nay roi `/etc/init.d/hud restart`.
# KHONG sua init script.

# --can socketcan:can0   cong CAN cua bo
# --probe on             tu do toc do bus + kieu dia chi luc khoi dong. BAT BUOC:
#                        mac dinh la `auto`, ma `auto` KHONG do khi can0 da duoc
#                        init dua len -> HUD cam ca chuyen.
# --obd2                 cho phep NOI CHUYEN OBD-II voi xe. Gom CA buoc bat tay
#                        chuan ISO 15765-4 (hoi 0x7DF o 500k/250k khi nghe khong
#                        ra gi — can cho xe co gateway cach ly cong OBD) LAN vong
#                        hoi PID sau do. KHONG can --active-probe rieng.
# --signals              bang tin hieu CHAN. Xem chan-demo.cfg — bo di la HUD
#                        giai ma bua khung quang ba cua xe thanh toc do gia.
# --navlink btspp:3        dong cong UDP 5077 (mac dinh cu mo ra MOI giao dien).
#
# KHONG co --loud-probe: do that 23/08/2026 cho thay bo CAM KHAU DUOC
# (`can <LISTEN-ONLY,FD>`), duong fail-closed chua bao gio chay, co do thua.
HUD_ARGS="--can socketcan:can0 --probe on --obd2 --signals /etc/hud/chan-demo.cfg --navlink btspp:3"

# NUT BAM — de "auto" thi init script TU DO ban phim USB va chen vao HUD_ARGS.
#
# Vi sao khong ghim thang `evdev:/dev/input/event1` vao HUD_ARGS: so hieu event
# phu thuoc THU TU CAM. Bo co san `gpio-keys` chiem event0, ban phim USB thuong
# ra event1 — nhung rut ra cam lai la no nhay so. Ghim cung thi mot lan cam lai
# la HUD mat nut bam ma khong mot dong loi nao.
#
# Dau hieu nhan ban phim THAT la handler `leds` (den Caps Lock) — `gpio-keys`
# co `kbd` nhung KHONG co `leds`, nen loc theo `kbd`+`leds` la chac.
#
# Ma phim: 28=Enter(man ke) 14=Backspace(man truoc) 33=F(xoay lat)
#          103/108=len/xuong(do sang) 2,3,4=man 1/2/3
# CO Y khong gan phim nao vao QUIT: start-stop-daemon khong tu khoi dong lai,
# nen mot phim lam tat HUD giua duong la qua rui ro.
#   auto        -> tu do, khong thay ban phim thi dung null: (an toan)
#   null:       -> tat han nut bam
#   evdev:...   -> chi dinh tay
HUD_INPUT=auto
HUD_INPUT_KEYS=28,14,33,103,108,2,3,4

HUD_FLIP="--flip v"
CAN_IF=can0
CAN_BITRATE=500000
CAN_DBITRATE=2000000
CAN_LISTEN_ONLY=yes
FB_WAIT_S=10
LOGFILE=/var/log/hud.log
